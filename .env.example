# Copy to .env on the VM and change every key. This file is an example.
# Local `docker compose up` already sets the local-dev values in docker-compose.yml.

DATABASE_URL=postgresql://rooftop:rooftop@db:5432/rooftop
MLFLOW_TRACKING_URI=http://mlflow:5000
API_KEY=local-dev-key
ADMIN_API_KEY=local-admin-key
CORS_ORIGINS=http://localhost:8000,http://localhost:3000
DEVICE_TOKEN=local-device-key
LOG_LEVEL=INFO
STALE_AFTER_MINUTES=120

# Leave empty unless a broker is on the docker network.
MQTT_URL=

# Optional S3-compatible artefact store for MLflow. Empty uses the mlflow volume.
# MLFLOW_S3_ENDPOINT_URL=https://s3.ap-south-1.amazonaws.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Set the MLflow command artefact root to s3://<bucket>/mlflow when these are set.

# Used by the vm profile. A real hostname gets a certificate from Caddy.
SITE_ADDRESS=localhost
ACME_EMAIL=
