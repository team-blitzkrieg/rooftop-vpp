# Copy to .env for local docker compose or a local API. Do not commit the copy.
# GitHub Actions uses repository secrets with the same names. Leave a secret
# unset rather than putting a real value in this file.

DATABASE_URL=postgresql://rooftop:rooftop@localhost:5432/rooftop
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MODEL_BUCKET=models
GITHUB_TOKEN=
GITHUB_REPOSITORY=team-blitzkrieg/rooftop-vpp

# Empty READ_API_KEY means forecast reads are open. Set it on a public host.
READ_API_KEY=
# Promote refuses to run until this is set.
ADMIN_API_KEY=

# Manual retrain only. The weekly cron does not set this.
ALLOW_SYNTHETIC=false
PORT=8000
